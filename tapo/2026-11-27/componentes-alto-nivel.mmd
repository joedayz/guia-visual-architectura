%% Fuente: tapp-onboarding-base-2026-11-26.md y la lámina 22 del 27-nov.
%% Una caja es una plataforma. Backend SMP es la solución, cerrada.
%% Punteado: la fuente lo nombra y no cierra contrato o zona.
flowchart TB
    subgraph CANAL["Canal"]
        CLI["Cliente Interbank"]
        APP["App Interbank<br/>SDK UPI CL y SDK BCO"]
    end

    subgraph IBK["Interbank"]
        subgraph AZ["Cloud Azure IBK"]
            BE["Backend SMP"]
            CACHE[("Redis<br/>listas de PSP y de proveedores")]
            TOK[("Almacén del token CL<br/>ubicación por confirmar")]
            APIM["APIM Interno PCI"]
            PCIBK["Proveedor de Cuentas"]
        end
        subgraph ONP["On-premise"]
            PRE["Pre-DBFD"]
            SRM["SRM"]
            CORE["CBS, DCMS y ATM"]
        end
        subgraph AWS["Cloud AWS IBK"]
            GW["API Gateway de terceros PCI"]
            LTD["LTD"]
            BCO["BCO"]
        end
        IAP["IAP<br/>zona sin cerrar"]
    end

    subgraph IZI["Izipay · Cloud AWS Izipay"]
        PAC["PAC @interbank"]
    end

    subgraph EXT["Externo"]
        UPI["UPI Switch<br/>directorio BCRP"]
        PCX["Proveedor de cuenta externo"]
    end

    CLI --> APP
    APP --> BE
    BE --> CACHE
    BE -.-> TOK
    BE --> PRE
    BE --> SRM
    BE -.-> CORE
    BE --> GW
    BE -.-> IAP
    BE -.-> APIM
    APIM -.-> PCIBK
    GW -->|"síncrono"| PAC
    GW -->|"asíncrono"| LTD
    GW -->|"asíncrono"| BCO
    PAC --> UPI
    UPI -.-> PCX

