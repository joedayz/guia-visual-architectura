flowchart TB
    subgraph APP["App Interbank"]
        UI["Pantallas<br/>bienvenida, antes de comenzar,<br/>entidad, cuentas, tarjeta y clave"]
        SIM["Lectura de SIM y envío de SMS"]
        SDK["SDK UPI CL<br/>getCLVersion, getChallenge, registerApp"]
    end

    subgraph BE["Backend SMP · Azure"]
        ORQ["Orquestación de onboarding"]
        CACHE[("Redis<br/>ListPsp y ListAccPvd<br/>TTL 1 h, dato global")]
        TOK[("Token CL y versión<br/>almacén por confirmar")]
    end

    subgraph IBK["Capacidades Interbank"]
        SRM["SRM"]
        PRE["Pre-DBFD"]
        IAP["IAP"]
        CORE["CBS · DCMS · ATM"]
        GW["API Gateway terceros PCI"]
        LTD["LTD"]
        BCOBOX["BCO"]
    end

    subgraph PACZ["PAC · AWS Izipay"]
        PAC["PAC"]
    end

    UPI["UPI Switch · directorio BCRP"]

    UI --> ORQ
    SIM --> ORQ
    SDK --> ORQ
    ORQ --> CACHE
    ORQ -.-> TOK

    ORQ -->|"2.3 celular"| SRM
    ORQ -->|"2.2 y 2.1 real-time<br/>4.3, 6.a y 6.b post-mortem async"| PRE
    ORQ -.->|"2.2 diferencia on-us<br/>servicio sin nombre"| IAP
    ORQ -.->|"HU 12: cuenta, tarjeta y PIN<br/>camino no dibujado en el deck"| CORE

    ORQ --> GW
    GW -->|"sync QueryDeviceDetailsReq<br/>sync ValidateDeviceDetailsReq"| PAC
    GW -->|"sync ListKeys, ListPsp, ListAccPvd, QueryVPAs"| PAC
    GW -->|"sync ReqListAccPvd, ListAccountReq, AddAccountReq"| PAC
    GW -->|"sync UpiOtpRequest, UpiPinReq, BalEnqReq"| PAC
    GW -->|"sync getMapperAddressListReq<br/>sync createMapperReq"| PAC
    GW -->|"4.4 y 5.a 5.b evidencia async"| LTD
    GW -->|"4.4 comportamental async"| BCOBOX

    PAC -->|"creación: las dos llamadas de dispositivo"| UPI
    PAC -->|"CHECK, PORT, MODIFY y alta de celular"| UPI

