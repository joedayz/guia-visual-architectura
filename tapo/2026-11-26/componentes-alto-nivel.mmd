    classDef aws fill:#fff1dc,stroke:#e67e22,color:#4a2a05
    classDef izipay fill:#ede7f6,stroke:#5e35b1,color:#26124d
    classDef externo fill:#eeeeee,stroke:#555555,color:#222
    classDef store fill:#fffbe6,stroke:#b08900,color:#3a2e00
    classDef pendiente stroke-dasharray:5 5

    class CLI,APP canal
