%% Fuente: docs/architecture/tapp-onboarding-base-2026-11-26.md
%% Deck TAPP-Onboarding.pdf y DHU ETCDYP-DHU Onboarding.
%% Línea punteada = nombrado por una fuente, sin camino o contrato cerrado.
flowchart TB
    subgraph CANAL["Canal"]
        CLI(["Cliente Interbank"])
        APP["App Interbank SMP<br/>Android e iOS<br/>SDK UPI CL y SDK BCO"]
    end

    subgraph IBK["Interbank"]
        subgraph AZ["Cloud Azure IBK"]
            BE["Backend del app<br/>orquesta post-login, creación y afiliación"]
            CACHE[("Redis<br/>listas de PSP y de proveedores<br/>vigencia 1 hora")]
            TOK[("Almacén del token CL<br/>ubicación por confirmar")]
        end
        subgraph ONP["On-premise"]
            PRE["Pre-DBFD<br/>real-time y post-mortem"]
            SRM["SRM<br/>celular del cliente"]
        end
        subgraph AWS["Cloud AWS IBK"]
            GW["API Gateway de terceros PCI<br/>capa de integración"]
            LTD["LTD<br/>evidencia digital"]
            BCO["BCO<br/>registro comportamental"]
        end
        IAP["IAP<br/>diferencia de cuentas on-us"]
        CORE["CBS, DCMS y ATM<br/>cuenta, tarjeta y clave de cajero"]
    end

    subgraph IZI["Izipay · Cloud AWS Izipay"]
        PAC["PAC<br/>post-login: PAC @interbank"]
    end

    subgraph EXT["Externo"]
        UPI["UPI Switch<br/>directorio BCRP"]
    end

    CLI --> APP
    APP -->|"entra a la zona TAPP"| BE
    BE --> CACHE
    BE -.-> TOK
    BE -->|"real-time y post-mortem"| PRE
    BE -->|"celular en la creación"| SRM
    BE -->|"síncrono hacia el PAC"| GW
    GW --> PAC
    GW -->|"evidencia, asíncrono"| LTD
    GW -->|"comportamental, asíncrono"| BCO
    BE -.->|"sin nombre de servicio"| IAP
    BE -.-> CORE
    PAC -->|"creación y directorio"| UPI

