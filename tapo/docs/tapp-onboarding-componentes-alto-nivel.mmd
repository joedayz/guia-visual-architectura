flowchart TB
    subgraph CANAL["Canal"]
        CLI(["Cliente Interbank"])
        APP["App Interbank (SMP)<br/>Android · iOS<br/>SDK UPI CL · SDK BCO"]
    end

    subgraph IBK["Interbank"]
        subgraph AZ["Cloud Azure IBK"]
            BE["Interbank App Backend (SMP)<br/>post-login, creación y afiliación"]
            CACHE[("Redis<br/>listas de PSP y proveedores<br/>TTL 1 h")]
            TOK[("BD del canal<br/>token CL y CLVersion<br/>(P34)")]
        end
        subgraph ONP["On-premise IBK (distribuido y mainframe)"]
            PRE["Pre-DBFD<br/>fraude real-time y post-mortem"]
            DBFD["DBFD"]
            SRM["SRM<br/>celular del cliente"]
        end
        subgraph AWSI["Cloud AWS IBK"]
            GW["API Gateway Terceros<br/>(PCI)"]
            LTD["LTD<br/>evidencia digital"]
            BCO["BCO<br/>fraude comportamental"]
        end
        CI["Consulta integrada (core)<br/>vía API interno (P14)"]
        PC["Proveedor de Cuentas<br/>Interbank"]
    end

    subgraph IZI["Izipay (PAC) · Cloud AWS Izipay"]
        PAC["PAC / TCS<br/>Tapp ID, cuentas, Clave Tapp,<br/>consultas al directorio"]
    end

    subgraph EXT["Externo"]
        UPI["UPI Switch<br/>Directorio BCRP"]
        PCX["Proveedores de cuenta<br/>de otros bancos"]
    end

    CLI --> APP
    APP -->|"zona TAPP y onboarding"| BE
    BE --> CACHE
    BE --> TOK
    BE -->|"real-time / post-mortem"| PRE
    PRE --> DBFD
    BE -->|"celular (creación)"| SRM
    BE -.->|"cruce de réplica (afiliación)"| CI
    BE -->|"síncrono"| GW
    GW --> PAC
    GW -->|"evidencia"| LTD
    GW -.-> BCO
    PAC -->|"directorio, OTP (P33)"| UPI
    UPI --> PCX
    UPI -.->|"P33"| PC
    PAC -.->|"on-us directo (P33)"| PC

